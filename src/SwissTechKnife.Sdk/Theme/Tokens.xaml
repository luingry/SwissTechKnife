<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Design tokens. Every visual value in the app (and in modules) comes from here.
        See docs/DESIGN_SYSTEM.md for usage rules. Reference with StaticResource
        (the theme is dark-only; static lookups are faster and work inside storyboards).
    -->

    <!-- ═══ Color primitives ═══ -->
    <!-- Surfaces: elevation is expressed by tone, never by strokes. -->
    <Color x:Key="Color.Canvas">#141413</Color>
    <Color x:Key="Color.Surface1">#1B1A18</Color>
    <Color x:Key="Color.Surface2">#22211E</Color>
    <Color x:Key="Color.Surface3">#2A2926</Color>
    <Color x:Key="Color.Surface4">#33312D</Color>
    <Color x:Key="Color.Surface5">#3D3B36</Color>
    <Color x:Key="Color.Scrim">#B80A0A09</Color>
    <Color x:Key="Color.Transparent">#00000000</Color>
    <Color x:Key="Color.Overlay.Hover">#0DFFFFFF</Color>
    <Color x:Key="Color.Overlay.Pressed">#17FFFFFF</Color>

    <!-- Text -->
    <Color x:Key="Color.Text.Primary">#F3F0EA</Color>
    <Color x:Key="Color.Text.Secondary">#B8B2A8</Color>
    <Color x:Key="Color.Text.Tertiary">#8C867D</Color>
    <Color x:Key="Color.Text.Disabled">#5E5A53</Color>

    <!-- Accent: primary actions, current selection, brand core. -->
    <Color x:Key="Color.Accent">#E8743C</Color>
    <Color x:Key="Color.Accent.Hover">#F2874F</Color>
    <Color x:Key="Color.Accent.Pressed">#D2622C</Color>
    <Color x:Key="Color.Accent.Soft">#24E8743C</Color>
    <Color x:Key="Color.Accent.SoftHover">#36E8743C</Color>
    <Color x:Key="Color.Accent.Focus">#A6E8743C</Color>
    <Color x:Key="Color.OnAccent">#1C1009</Color>

    <!-- Semantic complements: status only, never decoration. -->
    <Color x:Key="Color.Success">#63C28F</Color>
    <Color x:Key="Color.Success.Soft">#2163C28F</Color>
    <Color x:Key="Color.Info">#5FB3D0</Color>
    <Color x:Key="Color.Info.Soft">#215FB3D0</Color>
    <Color x:Key="Color.Warning">#E8B54D</Color>
    <Color x:Key="Color.Warning.Soft">#21E8B54D</Color>
    <Color x:Key="Color.Danger">#EB6A5F</Color>
    <Color x:Key="Color.Danger.Soft">#21EB6A5F</Color>
    <Color x:Key="Color.Danger.SoftHover">#33EB6A5F</Color>
    <Color x:Key="Color.Danger.Strong">#C9483E</Color>

    <!-- ═══ Brushes (frozen) ═══ -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface1" Color="{StaticResource Color.Surface1}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface4" Color="{StaticResource Color.Surface4}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface5" Color="{StaticResource Color.Surface5}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="{StaticResource Color.Transparent}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Overlay.Hover" Color="{StaticResource Color.Overlay.Hover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Overlay.Pressed" Color="{StaticResource Color.Overlay.Pressed}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Overlay.Lighten" Color="#1FFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Overlay.Darken" Color="#1F000000" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{StaticResource Color.Accent.Soft}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent.Focus" Color="{StaticResource Color.Accent.Focus}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="{StaticResource Color.Success.Soft}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="{StaticResource Color.Info.Soft}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="{StaticResource Color.Warning.Soft}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="{StaticResource Color.Danger.Soft}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Danger.Strong" Color="{StaticResource Color.Danger.Strong}" po:Freeze="True" />

    <!-- ═══ Typography ═══ -->
    <!-- One family (Segoe UI Variable: Display optical size for headings, Text for UI), plus the system icon font. -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSize.Overline">11</sys:Double>
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">15</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>
    <sys:Double x:Key="FontSize.Display">28</sys:Double>
    <sys:Double x:Key="FontSize.Icon.Sm">12</sys:Double>
    <sys:Double x:Key="FontSize.Icon">16</sys:Double>

    <!-- ═══ Spacing (4px grid) ═══ -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">20</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.8">32</sys:Double>
    <sys:Double x:Key="Space.10">40</sys:Double>

    <!-- ═══ Radii ═══ -->
    <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Radius.Md">10</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">14</CornerRadius>
    <CornerRadius x:Key="Radius.Xl">20</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- ═══ Sizes ═══ -->
    <sys:Double x:Key="Size.Control.Sm">28</sys:Double>
    <sys:Double x:Key="Size.Control">36</sys:Double>
    <sys:Double x:Key="Size.Control.Lg">42</sys:Double>
    <sys:Double x:Key="Size.TitleBar">40</sys:Double>
    <sys:Double x:Key="Size.Sidebar">236</sys:Double>

    <!-- ═══ Motion ═══ -->
    <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
    <Duration x:Key="Motion.Normal">0:0:0.2</Duration>
    <Duration x:Key="Motion.Slow">0:0:0.28</Duration>
    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut" po:Freeze="True" />
    <CubicEase x:Key="Ease.InOut" EasingMode="EaseInOut" po:Freeze="True" />
    <QuinticEase x:Key="Ease.Emphasized" EasingMode="EaseOut" po:Freeze="True" />

    <!-- ═══ Elevation (used sparingly: dialogs, popups, toasts) ═══ -->
    <DropShadowEffect x:Key="Elevation.Overlay" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.5" Color="#000000" RenderingBias="Performance" po:Freeze="True" />
    <DropShadowEffect x:Key="Elevation.Popup" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" RenderingBias="Performance" po:Freeze="True" />

    <!-- ═══ Focus (keyboard only) ═══ -->
    <Style x:Key="FocusVisual.Ring">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource Brush.Accent.Focus}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
