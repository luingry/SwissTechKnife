<Window x:Class="SwissTechKnife.Views.ModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:SwissTechKnife.Infrastructure"
        xmlns:ui="clr-namespace:SwissTechKnife.Sdk;assembly=SwissTechKnife.Sdk"
        Title="{Binding Name}"
        Width="980" Height="700" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Canvas}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource FontSize.Body}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <!-- A module's page in a window of its own (double click on its notification-area icon). DataContext = ModuleItem. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Source={StaticResource Size.TitleBar}}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <ContentControl Style="{StaticResource IconTile}" Width="20" Height="20" Padding="4" ui:Ui.CornerRadius="6" />
            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyStrong}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource Button.Caption}" ui:Ui.Icon="&#xE921;" Click="OnMinimize" ToolTip="{infra:Loc Minimize}" />
            <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" ui:Ui.Icon="&#xE922;" Click="OnMaximize" />
            <Button Style="{StaticResource Button.Caption.Close}" ui:Ui.Icon="&#xE8BB;" Click="OnClose" ToolTip="{infra:Loc Close}" />
        </StackPanel>

        <Grid x:Name="PageHost" Grid.Row="1" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PageMove" />
            </Grid.RenderTransform>
            <Border x:Name="Page" />
        </Grid>
    </Grid>
</Window>
