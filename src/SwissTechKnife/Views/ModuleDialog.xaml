<UserControl x:Class="SwissTechKnife.Views.ModuleDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SwissTechKnife.Sdk;assembly=SwissTechKnife.Sdk"
             Visibility="Collapsed"
             KeyboardNavigation.TabNavigation="Cycle">
    <Grid>
        <Border x:Name="Scrim" Background="{StaticResource Brush.Scrim}" Opacity="0" CornerRadius="{StaticResource Radius.Lg}" MouseLeftButtonDown="OnScrimClick" />

        <Border x:Name="Card" Width="548" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Xl}"
                Effect="{StaticResource Elevation.Overlay}" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.96" ScaleY="0.96" />
                    <TranslateTransform x:Name="CardMove" Y="10" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid x:Name="Body" Margin="28,28,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource IconTile}" Width="64" Height="64" Padding="15" ui:Ui.CornerRadius="18" />
                    <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="{Binding Byline}" Style="{StaticResource Text.Caption}" Margin="0,3,0,8" />
                        <ContentControl Style="{StaticResource StatusChip}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource Button.Icon.Sm}" ui:Ui.Icon="&#xE711;" ToolTip="Fechar (Esc)"
                            VerticalAlignment="Top" Margin="0,-10,-10,0" Click="OnCloseClick" />
                </Grid>

                <!-- Description -->
                <ScrollViewer Grid.Row="1" MaxHeight="220" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Paragraph}" />
                </ScrollViewer>

                <!-- Facts -->
                <Grid Grid.Row="2" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Versão" Style="{StaticResource Text.Overline}" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.BodyStrong}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding UpdateText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Accent}" Margin="0,2,0,0"
                                   Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Tamanho" Style="{StaticResource Text.Overline}" />
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.BodyStrong}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Categoria" Style="{StaticResource Text.Overline}" />
                        <TextBlock Text="{Binding Category}" Style="{StaticResource Text.BodyStrong}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Notices -->
                <StackPanel Grid.Row="3">
                    <Border Background="{StaticResource Brush.Warning.Soft}" CornerRadius="{StaticResource Radius.Md}" Padding="14,10" Margin="0,20,0,0"
                            Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE777;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{StaticResource Brush.Warning}" />
                            <TextBlock Grid.Column="1" Text="{Binding RestartReason}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextTrimming="None" Margin="12,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Content="Reiniciar agora" MinHeight="28" Padding="10,0"
                                    Foreground="{StaticResource Brush.Warning}"
                                    Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource Brush.Danger.Soft}" CornerRadius="{StaticResource Radius.Md}" Padding="14,10" Margin="0,20,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE783;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{StaticResource Brush.Danger}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Error}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextTrimming="None" Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,22,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding Progress, Converter={StaticResource Percent}}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" />
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <Grid Grid.Row="4" Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="UninstallButton" ui:Ui.Icon="&#xE74D;"
                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Danger}">
                                <Setter Property="Content" Value="Desinstalar" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConfirmingUninstall}" Value="True">
                                        <Setter Property="Content" Value="Confirmar remoção" />
                                        <Setter Property="Background" Value="{StaticResource Brush.Danger.Strong}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Secondary}" ui:Ui.Icon="&#xE769;" Content="Desativar" Margin="8,0,0,0"
                                Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                Visibility="{Binding ShowDisable, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Secondary}" ui:Ui.Icon="&#xE8A7;" Content="Abrir" Margin="8,0,0,0"
                                Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                Visibility="{Binding ShowOpenSecondary, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE768;" Content="Ativar" Margin="8,0,0,0"
                                Command="{Binding DataContext.EnableCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                Visibility="{Binding ShowEnable, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE8A7;" Content="Abrir" Margin="8,0,0,0"
                                Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                Visibility="{Binding ShowOpenPrimary, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE895;" Content="Atualizar" Margin="8,0,0,0"
                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE896;" Content="Instalar" Margin="8,0,0,0"
                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE823;" Content="Em breve" Margin="8,0,0,0" IsEnabled="False"
                                Visibility="{Binding ShowComingSoon, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
