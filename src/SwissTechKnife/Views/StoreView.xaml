<UserControl x:Class="SwissTechKnife.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SwissTechKnife.Sdk;assembly=SwissTechKnife.Sdk"
             xmlns:controls="clr-namespace:SwissTechKnife.Controls"
             xmlns:vm="clr-namespace:SwissTechKnife.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="ModuleCardTemplate" DataType="{x:Type vm:ModuleItem}">
            <Button x:Name="Card" Style="{StaticResource ModuleCard}" Opacity="0"
                    Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Style="{StaticResource IconTile}" />
                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Subtitle}" />
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ContentControl Grid.Column="2" Style="{StaticResource StatusChip}" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Tagline}" Style="{StaticResource Text.Paragraph}" Height="40" Margin="0,16,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Grid.Row="2" Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="0,14,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Enable switch (installed modules). It handles its own clicks, so the card does not open. -->
                    <CheckBox Grid.Row="3" Style="{StaticResource Switch}" HorizontalAlignment="Right" Margin="0,12,0,0"
                              IsChecked="{Binding IsActive, Mode=TwoWay}" Content="{Binding ActiveText}"
                              Foreground="{StaticResource Brush.Text.Secondary}" FontSize="{StaticResource FontSize.Caption}"
                              AutomationProperties.Name="{Binding Name, StringFormat=Ativar {0}}"
                              Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <Button.RenderTransform>
                    <TranslateTransform x:Name="Enter" Y="8" />
                </Button.RenderTransform>
            </Button>
            <DataTemplate.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Card">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Slow}" />
                            <DoubleAnimation Storyboard.TargetName="Enter" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Motion.Slow}" EasingFunction="{StaticResource Ease.Emphasized}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

            </DataTemplate.Triggers>
        </DataTemplate>

        <Storyboard x:Key="SkeletonPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0.9" Duration="0:0:0.9" EasingFunction="{StaticResource Ease.InOut}" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="36,32,36,0">
            <TextBlock Text="Módulos" Style="{StaticResource Text.Display}" />
            <TextBlock Style="{StaticResource Text.Paragraph}" MaxWidth="600" HorizontalAlignment="Left" Margin="0,6,0,0"
                       Text="Instale só o que você usa. Cada módulo roda dentro do SwissTechKnife, no mesmo processo, e pode ser desativado ou removido a qualquer momento." />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="36,24,36,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Segmented.Container}" HorizontalAlignment="Left">
                <ui:SegmentedPanel>
                    <RadioButton Style="{StaticResource Segmented.Item}" GroupName="StoreTab" IsChecked="{Binding IsAvailableTab}" AutomationProperties.Name="Disponíveis">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Disponíveis" />
                            <TextBlock Text="{Binding AvailableCount}" Margin="8,0,0,0" Foreground="{StaticResource Brush.Text.Tertiary}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segmented.Item}" GroupName="StoreTab" IsChecked="{Binding IsInstalledTab}" AutomationProperties.Name="Instalados">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Instalados" />
                            <TextBlock Text="{Binding InstalledCount}" Margin="8,0,0,0" Foreground="{StaticResource Brush.Text.Tertiary}" />
                        </StackPanel>
                    </RadioButton>
                </ui:SegmentedPanel>
            </Border>

            <!-- Catalog notice (offline / failed) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0"
                        Visibility="{Binding HasCatalogNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.Warning}" />
                <TextBlock Text="{Binding CatalogMessage}" Style="{StaticResource Text.Caption}" Margin="8,0,4,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource Button.Ghost}" Content="Tentar de novo" MinHeight="28" Padding="10,0" Command="{Binding ReloadCatalogCommand}" />
            </StackPanel>

            <TextBox Grid.Column="2" Style="{StaticResource TextBox.Search}" Width="260" ui:Ui.Placeholder="Buscar módulos"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- List -->
        <ScrollViewer Grid.Row="2" Padding="36,0,36,36" CanContentScroll="False">
            <Grid>
                <ItemsControl ItemsSource="{Binding StoreItems}" ItemTemplate="{StaticResource ModuleCardTemplate}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveGrid MinColumnWidth="300" Gap="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Skeletons while the catalog loads (only if nothing is shown yet) -->
                <ItemsControl Focusable="False" Visibility="{Binding ShowSkeletons, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveGrid MinColumnWidth="300" Gap="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Items>
                        <Border Style="{StaticResource Card}" Padding="18" Height="136" />
                        <Border Style="{StaticResource Card}" Padding="18" Height="136" />
                        <Border Style="{StaticResource Card}" Padding="18" Height="136" />
                    </ItemsControl.Items>
                    <ItemsControl.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource SkeletonPulse}" />
                        </EventTrigger>
                    </ItemsControl.Triggers>
                </ItemsControl>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0" MaxWidth="360"
                            Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Brush.Surface3}" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EmptyIcon}" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="{StaticResource Brush.Text.Secondary}" />
                    </Border>
                    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,18,0,6" />
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Paragraph}" TextAlignment="Center" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Ver disponíveis" HorizontalAlignment="Center" Margin="0,18,0,0"
                            Command="{Binding ShowTabCommand}" CommandParameter="{x:Static vm:StoreTab.Available}"
                            Visibility="{Binding EmptyOffersAvailable, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Secondary}" ui:Ui.Icon="&#xE72C;" Content="Tentar de novo" HorizontalAlignment="Center" Margin="0,18,0,0"
                            Command="{Binding ReloadCatalogCommand}"
                            Visibility="{Binding HasCatalogNotice, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
