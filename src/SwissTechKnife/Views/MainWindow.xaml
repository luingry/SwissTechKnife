<Window x:Class="SwissTechKnife.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:SwissTechKnife.Infrastructure"
        xmlns:ui="clr-namespace:SwissTechKnife.Sdk;assembly=SwissTechKnife.Sdk"
        xmlns:views="clr-namespace:SwissTechKnife.Views"
        Title="SwissTechKnife"
        Width="1180" Height="760" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="/SwissTechKnife;component/Assets/swisstechknife.ico"
        Background="{StaticResource Brush.Canvas}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource FontSize.Body}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Source={StaticResource Size.TitleBar}}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Title bar ═══ -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="{StaticResource Brand.Logo}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="SwissTechKnife" Style="{StaticResource Text.BodyStrong}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding HostVersion}" Style="{StaticResource Text.Caption}" Margin="8,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" Style="{StaticResource Button.Caption}" ui:Ui.Icon="&#xE921;" Click="OnMinimize" ToolTip="{infra:Loc Minimize}" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" ui:Ui.Icon="&#xE922;" Click="OnMaximize" />
                <Button Style="{StaticResource Button.Caption.Close}" ui:Ui.Icon="&#xE8BB;" Click="OnClose" ToolTip="{infra:Loc Close}" />
            </StackPanel>
        </Grid>

        <!-- ═══ Body ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Source={StaticResource Size.Sidebar}}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <DockPanel Grid.Column="0" Margin="12,6,12,14">

                <!-- Settings entry pinned to the bottom of the sidebar -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource Nav.Button}" Command="{Binding ShowSettingsCommand}" Tag="{Binding IsSettingsActive}"
                        AutomationProperties.Name="{infra:Loc SettingsTitle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE713;" Style="{StaticResource Text.Icon}" FontSize="15" Margin="2,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{infra:Loc SettingsTitle}" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Style="{StaticResource Chip}" Background="{StaticResource Brush.Success.Soft}" Padding="7,0" Height="20"
                                Visibility="{Binding Settings.HostUpdate.IsAvailable, Converter={StaticResource BoolToVisibility}}" ToolTip="{infra:Loc HostUpdateAvailable}">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Text.Icon}" Foreground="{StaticResource Brush.Success}" FontSize="11" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource Nav.Button}" Command="{Binding ShowStoreCommand}" Tag="{Binding IsStoreActive}" AutomationProperties.Name="{infra:Loc Modules}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE71D;" Style="{StaticResource Text.Icon}" FontSize="15" Margin="2,0,12,0" />
                            <TextBlock Grid.Column="1" Text="{infra:Loc Modules}" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource Chip}" Background="{StaticResource Brush.Success.Soft}" Padding="7,0" Height="20"
                                    Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}" ToolTip="{infra:Loc UpdatesAvailable}">
                                <TextBlock Text="{Binding UpdateCount}" Foreground="{StaticResource Brush.Success}" FontSize="11" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <TextBlock Text="{infra:Loc YourModules}" Style="{StaticResource Text.Overline}" Margin="12,22,0,8" />
                </StackPanel>

                <Grid>
                    <ListBox x:Name="SidebarList" ItemsSource="{Binding SidebarItems}" SelectedItem="{Binding CurrentModule}"
                             ItemContainerStyle="{StaticResource Nav.ListItem}" Padding="0" KeyboardNavigation.TabNavigation="Once">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource IconTile}" Width="26" Height="26" Padding="5" ui:Ui.CornerRadius="7" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{StaticResource Brush.Success}" Margin="8,0,0,0" ToolTip="{infra:Loc UpdateAvailable}"
                                             Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{infra:Loc SidebarEmpty}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                               Margin="12,2,8,0" VerticalAlignment="Top"
                               Visibility="{Binding HasSidebarModules, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                </Grid>
            </DockPanel>

            <!-- Content surface -->
            <Border Grid.Column="1" Background="{StaticResource Brush.Surface1}" CornerRadius="{StaticResource Radius.Lg}" Margin="0,0,8,8" ClipToBounds="True">
                <Grid x:Name="PageHost">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PageMove" />
                    </Grid.RenderTransform>

                    <views:StoreView Visibility="{Binding IsStoreActive, Converter={StaticResource BoolToVisibility}}" />

                    <views:SettingsView DataContext="{Binding Settings}"
                                        Visibility="{Binding DataContext.IsSettingsActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Module page -->
                    <Grid Visibility="{Binding IsModulePageActive, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid DataContext="{Binding CurrentModule}" Margin="28,20,20,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource IconTile}" Width="36" Height="36" Padding="8" ui:Ui.CornerRadius="10" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Subtitle}" />
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Caption}" Margin="0,1,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" ui:Ui.Icon="&#xE946;" Content="{infra:Loc Details}"
                                    Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        </Grid>

                        <ContentPresenter Grid.Row="1" Content="{Binding CurrentPage}" />

                        <!-- Page failure -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24"
                                    DataContext="{Binding CurrentModule}"
                                    Visibility="{Binding PageError, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Brush.Danger.Soft}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE783;" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="{StaticResource Brush.Danger}" />
                            </Border>
                            <TextBlock Text="{infra:Loc PageFailedTitle}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,18,0,6" />
                            <TextBlock Text="{Binding PageError}" Style="{StaticResource Text.Paragraph}" TextAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <Button Style="{StaticResource Button.Secondary}" Content="{infra:Loc DisableModule}" Margin="0,0,8,0"
                                        Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE72C;" Content="{infra:Loc TryAgain}"
                                        Command="{Binding DataContext.RetryPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE777;" Content="{infra:Loc RestartNow}"
                                        Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Details dialog (over the body; the title bar stays usable) -->
            <views:ModuleDialog x:Name="Dialog" Grid.ColumnSpan="2" />

            <!-- SwissTechKnife update confirmation (from Settings) -->
            <views:HostUpdateDialog x:Name="HostDialog" Grid.ColumnSpan="2" DataContext="{Binding Settings.HostUpdate}" />
        </Grid>

        <!-- Toasts -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" ItemTemplate="{StaticResource ToastTemplate}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" Focusable="False" />
    </Grid>
</Window>
