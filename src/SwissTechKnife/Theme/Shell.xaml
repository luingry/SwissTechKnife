<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:SwissTechKnife.Sdk;assembly=SwissTechKnife.Sdk"
                    xmlns:infra="clr-namespace:SwissTechKnife.Infrastructure"
                    xmlns:vm="clr-namespace:SwissTechKnife.ViewModels"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SwissTechKnife.Sdk;component/Theme/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Host-only components built from the design-system tokens (window chrome, navigation, module cards). -->

    <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <infra:NullToVisibilityConverter x:Key="NullToVisibility" />
    <infra:PercentConverter x:Key="Percent" />

    <!-- ═══ Caption buttons ═══ -->
    <Style x:Key="Button.Caption" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="{StaticResource Size.TitleBar}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ui:Ui.CornerRadius" Value="0" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>

    <Style x:Key="Button.Caption.Close" TargetType="Button" BasedOn="{StaticResource Button.Caption}">
        <Setter Property="ui:Ui.HoverBackground" Value="{StaticResource Brush.Danger.Strong}" />
        <Setter Property="ui:Ui.PressedBackground" Value="{StaticResource Brush.Overlay.Darken}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Sidebar navigation ═══ -->
    <ControlTemplate x:Key="Template.NavItem" TargetType="ContentControl">
        <Grid Background="Transparent">
            <Border x:Name="Hover" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="{StaticResource Radius.Md}" Opacity="0" />
            <Border x:Name="Active" Background="{StaticResource Brush.Surface3}" CornerRadius="{StaticResource Radius.Md}" Opacity="0" />
            <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource Brush.Accent}"
                    HorizontalAlignment="Left" Margin="-1,0,0,0" RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="IndicatorScale" ScaleY="0.3" />
                </Border.RenderTransform>
            </Border>
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Normal}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Normal}" EasingFunction="{StaticResource Ease.Out}" />
                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Normal}" />
                            <DoubleAnimation Storyboard.TargetName="IndicatorScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Motion.Slow}" EasingFunction="{StaticResource Ease.Emphasized}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Normal}" />
                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                            <DoubleAnimation Storyboard.TargetName="IndicatorScale" Storyboard.TargetProperty="ScaleY" To="0.3" Duration="{StaticResource Motion.Fast}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Store entry: a Button whose Tag carries the "active" flag. -->
    <Style x:Key="Nav.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentControl Template="{StaticResource Template.NavItem}" Tag="{TemplateBinding Tag}" Padding="{TemplateBinding Padding}"
                                    Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}" Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nav.ListItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,0,10,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentControl Template="{StaticResource Template.NavItem}" Tag="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}"
                                    Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Module icon tile (DataContext = ModuleItem) ═══ -->
    <Style x:Key="IconTile" TargetType="ContentControl">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ui:Ui.CornerRadius" Value="12" />
        <Setter Property="Padding" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{Binding TileBrush}" CornerRadius="{TemplateBinding ui:Ui.CornerRadius}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Viewbox x:Name="Vector" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding IconGeometry}" Stroke="{Binding AccentBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <!-- The module's own icon replaces the vector icon once loaded. -->
                            <Image x:Name="Raster" Source="{Binding IconImage}" Stretch="Uniform" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality" Margin="-3" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasIconImage}" Value="True">
                            <Setter TargetName="Vector" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Raster" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Status chip (DataContext = ModuleItem) ═══ -->
    <Style x:Key="StatusChip" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Tag" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Style="{StaticResource Chip}" Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{StaticResource FontSize.Caption}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:ModuleStatus.ComingSoon}">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Content" Value="Em breve" />
                <Setter Property="Background" Value="{StaticResource Brush.Info.Soft}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Info}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Content" Value="Atualização disponível" />
                <Setter Property="Background" Value="{StaticResource Brush.Success.Soft}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RestartRequired}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Content" Value="Reiniciar" />
                <Setter Property="Background" Value="{StaticResource Brush.Warning.Soft}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Content" Value="{Binding BusyText}" />
                <Setter Property="Background" Value="{StaticResource Brush.Accent.Soft}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Module card (Button, DataContext = ModuleItem) ═══ -->
    <Style x:Key="ModuleCard" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.2" GeneratedEasingFunction="{StaticResource Ease.Out}" />
                                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.992" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.992" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Lg}" />
                        <Border x:Name="Hover" Background="{StaticResource Brush.Surface3}" CornerRadius="{StaticResource Radius.Lg}" Opacity="0" />
                        <ContentPresenter Margin="18" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Skeleton card shown while the catalog loads ═══ -->
    <Style x:Key="SkeletonBlock" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface3}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
    </Style>

    <!-- ═══ Toast ═══ -->
    <DataTemplate x:Key="ToastTemplate" DataType="{x:Type vm:Toast}">
        <Border x:Name="Root" Background="{StaticResource Brush.Surface4}" CornerRadius="{StaticResource Radius.Md}" Padding="14,10,8,10"
                Margin="0,8,0,0" MinWidth="260" MaxWidth="420" Effect="{StaticResource Elevation.Popup}" Opacity="0" RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Move" Y="12" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Glyph" Text="{Binding Icon}" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{StaticResource Brush.Info}" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource Button.Icon.Sm}" ui:Ui.Icon="&#xE711;" Margin="10,0,0,0" ToolTip="Fechar"
                        Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Success">
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Danger}" />
            </DataTrigger>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Normal}" />
                        <DoubleAnimation Storyboard.TargetName="Move" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Motion.Slow}" EasingFunction="{StaticResource Ease.Emphasized}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <DataTrigger Binding="{Binding IsClosing}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Normal}" />
                            <DoubleAnimation Storyboard.TargetName="Move" Storyboard.TargetProperty="Y" To="8" Duration="{StaticResource Motion.Normal}" EasingFunction="{StaticResource Ease.Out}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
