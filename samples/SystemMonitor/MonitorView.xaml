<UserControl x:Class="SwissTechKnife.Samples.SystemMonitor.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Uses only design-system keys from SwissTechKnife.Sdk (resolved from the host at runtime). -->
    <ScrollViewer Padding="28,8,28,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- CPU -->
            <Border Grid.RowSpan="3" Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Processador" Style="{StaticResource Text.Overline}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="CpuText" Text="—" Style="{StaticResource Text.Display}" FontSize="40" />
                            <TextBlock Text="%" Style="{StaticResource Text.Title}" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Bottom" Margin="4,0,0,8" />
                        </StackPanel>
                        <TextBlock x:Name="CpuCaption" Style="{StaticResource Text.Caption}" Text="Uso nos últimos 60 segundos" />
                    </StackPanel>
                    <Grid Grid.Row="1" Height="160" Margin="0,24,0,0" VerticalAlignment="Bottom">
                        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Brush.Overlay.Hover}" />
                        <Border Height="1" VerticalAlignment="Center" Background="{StaticResource Brush.Overlay.Hover}" />
                        <Canvas x:Name="ChartHost" ClipToBounds="True">
                            <Polygon x:Name="CpuArea" Fill="{StaticResource Brush.Accent.Soft}" />
                            <Polyline x:Name="CpuLine" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" StrokeLineJoin="Round" />
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Grid.RowSpan="3">
            <!-- Memory -->
            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="Memória" Style="{StaticResource Text.Overline}" />
                    <TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource Text.Title}" Margin="0,6,0,0" />
                    <TextBlock x:Name="MemoryCaption" Text=" " Style="{StaticResource Text.Caption}" Margin="0,2,0,14" />
                    <ProgressBar x:Name="MemoryBar" Maximum="1" Height="6" />
                </StackPanel>
            </Border>

            <!-- Uptime -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Ligado há" Style="{StaticResource Text.Overline}" />
                    <TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource Text.Title}" Margin="0,6,0,0" />
                    <TextBlock Text="Desde a última inicialização do Windows" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
