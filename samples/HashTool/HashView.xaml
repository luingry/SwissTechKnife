<UserControl x:Class="SwissTechKnife.Samples.HashTool.HashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SwissTechKnife.Sdk;assembly=SwissTechKnife.Sdk"
             AllowDrop="True">
    <ScrollViewer Padding="28,8,28,28">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <!-- Source -->
            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Source" Style="{StaticResource Text.Overline}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Segmented.Container}" HorizontalAlignment="Right">
                            <ui:SegmentedPanel>
                                <RadioButton x:Name="TextTab" Style="{StaticResource Segmented.Item}" GroupName="Mode" Content="Text" IsChecked="True" Checked="OnModeChanged" />
                                <RadioButton x:Name="FileTab" Style="{StaticResource Segmented.Item}" GroupName="Mode" Content="File" Checked="OnModeChanged" />
                            </ui:SegmentedPanel>
                        </Border>
                    </Grid>

                    <TextBox x:Name="Input" Margin="0,16,0,0" Height="120" AcceptsReturn="True" TextWrapping="Wrap"
                             ui:Ui.Placeholder="Type or paste text…" TextChanged="OnInputChanged" />

                    <Border x:Name="DropZone" Margin="0,16,0,0" Height="120" CornerRadius="{StaticResource Radius.Md}" Background="{StaticResource Brush.Surface3}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="{StaticResource Brush.Text.Tertiary}" />
                            <TextBlock x:Name="FileLabel" Text="Drop a file here" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,10,0,10" />
                            <Button Style="{StaticResource Button.Secondary}" ui:Ui.Icon="&#xE838;" Content="Choose file" HorizontalAlignment="Center" Click="OnPickFile" />
                        </StackPanel>
                    </Border>
                    <ProgressBar x:Name="Progress" Maximum="1" Margin="0,14,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Results -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Results" Style="{StaticResource Text.Overline}" />
                    <ItemsControl x:Name="Results" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                             Background="{StaticResource Brush.Surface1}" />
                                    <Button Grid.Column="2" Style="{StaticResource Button.Icon}" ui:Ui.Icon="&#xE8C8;" ToolTip="Copy" Margin="8,0,0,0"
                                            Click="OnCopy" Tag="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
